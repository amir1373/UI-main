  <property name="styleSheet">
   <string notr="true">*{
	border: none;
	background-color: transparent;
	background: transparent;
	padding: 0;
	margin: 0;
	color: #fff;
}

#centralwidget
{
	background-color: #1f232a;
}

#header
{
	background-color: #030b1c;
}

#menuButtons, #customPositionMenuBar, #customTileMenuBar, #customRobotParamMenuBar, #manControllerMenu
{
	background-color: #011326;
}

#homeBtn
{
	border-top: 3px solid #7d7dfa;
}

#rightMenuSetting
{
	border-left: 5px solid #6c58d1;
}

#item1Btn
{
	border-top: 3px solid #6c58d1;
	border-bottom: 3px solid #6c58d1;
	border-left: 3px solid #6c58d1;
	background-color: #7d7dfa;
}

#endeffectorManControlBtn
{
	border: 3px solid #6c58d1;
	background-color: #7d7dfa;
}

#leftMenuSetting, #controllerMenu
{
	background-color: #00225c;
}

#statusLabel
{
	color: #0e9c09
}


#loginBtn
{
	background-color: rgb(0, 200, 0);
	border-radius: 3px;
}

#infoLabel
{
	color: rgb(200, 0, 0);
}

#passwordEdt
{
	border-bottom: 3px solid #7d7dfa;
}

#customizePosBtn
{
	background-color: #00225c;
	border-radius: 15px;
}

#savePosRobotBtn
{
	background-color: #33c70a;
}

#backToViewPositionsSettingBtn
{
	background-color: #c70a0a;
}

#customizeTakePosBtn, #customizeCollPathPosBtn, #customizeFirstTilePosBtn, #customizeWaitPosBtn
{
	background-color: #00225c;
	border-radius: 15px;
}

#thicknessMinusBtn, #thicknessPlusBtn
{
	border-radius: 17px;
	border: 3px solid #00225c;
}

#heightMinusBtn, #heightPlusBtn, #widthPlusBtn, #widthMinusBtn
{
	border-radius: 12px;
	border: 3px solid #00225c;
}</string>
